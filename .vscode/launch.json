{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chatbot interactivo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/chatbot_servicios.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Pruebas de conversaciones",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["test_chatbot.py"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
